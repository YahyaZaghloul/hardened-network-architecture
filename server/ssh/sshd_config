# =============================================================================
# sshd_config — Hardened SSH Server Configuration
# Server: pc-b (192.168.20.10) — Ubuntu 24.04 LTS
# =============================================================================

# --- Network ---
Port 22
AddressFamily inet
ListenAddress 0.0.0.0

# --- Authentication ---
PermitRootLogin no
MaxAuthTries 3
MaxSessions 5

# Password authentication (enabled for lab — disable and use keys in production)
PasswordAuthentication yes
PermitEmptyPasswords no

# Public key authentication (recommended)
PubkeyAuthentication yes
AuthorizedKeysFile .ssh/authorized_keys

# Disable unused auth methods
ChallengeResponseAuthentication no
KerberosAuthentication no
GSSAPIAuthentication no
UsePAM yes

# --- Session Security ---
X11Forwarding no
PrintLastLog yes
TCPKeepAlive yes
ClientAliveInterval 300
ClientAliveCountMax 2

# Disconnect idle sessions after 10 minutes
LoginGraceTime 60

# --- Logging ---
SyslogFacility AUTH
LogLevel VERBOSE

# --- Allowed users ---
# Uncomment and set to restrict SSH to specific users only
# AllowUsers ahmed

# --- Subsystems ---
Subsystem sftp /usr/lib/openssh/sftp-server

# --- Banner ---
Banner /etc/ssh/banner.txt
