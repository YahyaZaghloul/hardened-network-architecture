# -----------------------------------------------------------------------
# Snort 2.9.20 — Custom Local Rules
# File: /etc/snort/rules/local.rules
# Gateway VM — Hardened Network Architecture
# -----------------------------------------------------------------------
# HOME_NET = 192.168.10.0/24, 192.168.20.0/24
# EXTERNAL_NET = !$HOME_NET
# -----------------------------------------------------------------------

# 1. SYN Scan Detection
alert tcp any any -> $HOME_NET any (msg:"SYN Scan Detected"; flags:S; threshold:type both, track by_src, count 5, seconds 10; sid:1000001; rev:1;)

# 2. UDP Scan Detection
alert udp any any -> $HOME_NET any (msg:"UDP Scan Detected"; threshold:type both, track by_src, count 5, seconds 10; sid:1000002; rev:1;)

# 3. ICMP Ping Sweep Detection
alert icmp any any -> $HOME_NET any (msg:"ICMP Ping Sweep Detected"; itype:8; threshold:type both, track by_src, count 5, seconds 10; sid:1000003; rev:1;)

# 4. FIN Scan Detection
alert tcp any any -> $HOME_NET any (msg:"FIN Scan Detected"; flags:F; sid:1000004; rev:1;)

# 5. NULL Scan Detection
alert tcp any any -> $HOME_NET any (msg:"NULL Scan Detected"; flags:0; sid:1000005; rev:1;)

# 6. XMAS Scan Detection
alert tcp any any -> $HOME_NET any (msg:"XMAS Scan Detected"; flags:FPU; sid:1000006; rev:1;)

# 7. SSH Brute Force Detection
alert tcp any any -> $HOME_NET 22 (msg:"Possible SSH Brute Force"; flags:S; threshold:type both, track by_src, count 5, seconds 60; sid:1000007; rev:1;)

# 8. HTTP Flood / DoS Detection
alert tcp any any -> $HOME_NET 80 (msg:"HTTP Flood Detected"; flags:S; threshold:type both, track by_src, count 20, seconds 5; sid:1000008; rev:1;)

# 9. Nmap OS Fingerprint Detection
alert tcp any any -> $HOME_NET any (msg:"Nmap OS Fingerprint Probe"; flags:SF; sid:1000009; rev:1;)

# 10. Port Scan — Many ports from single source
alert tcp any any -> $HOME_NET any (msg:"Port Scan Detected"; flags:S; threshold:type threshold, track by_src, count 15, seconds 5; sid:1000010; rev:1;)
