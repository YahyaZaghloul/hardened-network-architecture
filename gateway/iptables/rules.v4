# Generated by iptables-save / netfilter-persistent
# Gateway VM — Hardened Network Architecture
# Applied: 2026-05-05

*filter
:INPUT ACCEPT [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]

# --- INPUT CHAIN ---
# Allow loopback traffic
-A INPUT -i lo -j ACCEPT

# Allow established/related connections back in
-A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT

# Drop invalid packets
-A INPUT -m conntrack --ctstate INVALID -j DROP

# --- FORWARD CHAIN ---
# Allow established/related connections to pass through
-A FORWARD -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT

# Allow HTTP (port 80) to DMZ server
-A FORWARD -p tcp -d 192.168.20.10 --dport 80 -j ACCEPT

# Allow HTTPS (port 443) to DMZ server
-A FORWARD -p tcp -d 192.168.20.10 --dport 443 -j ACCEPT

# Allow SSH (port 22) to DMZ server
-A FORWARD -p tcp -d 192.168.20.10 --dport 22 -j ACCEPT

COMMIT
